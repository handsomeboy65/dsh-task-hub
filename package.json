{
  "name": "dsh-tapd-tasks",
  "version": "0.6.0",
  "type": "module",
  "description": "Task hub: list TAPD requirements, ZenTao tasks and GitLab issues assigned to you, then dispatch a DSH agent on a branch you name.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tapd",
    "zentao",
    "gitlab",
    "issue-tracker",
    "workflow",
    "agent"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/tapd.js",
    "lib/zentao.js",
    "lib/gitlab.js",
    "lib/sources.js",
    "lib/store.js",
    "lib/checkout.js",
    "lib/dispatch.js",
    "lib/prompt.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/icon-512.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
